---
import LinkMark from './LinkMark.astro';
import { NAV, CTA, SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="bg-night text-mist" style="--lm-dark: #e3ebf1;">
  <div class="wrap grid gap-12 py-14 md:py-20 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <LinkMark class="h-12 w-12" />
      <p class="heading mt-5 max-w-sm text-2xl text-paper">Connecting Laurier students with the people who move the world's goods.</p>
      <a href={CTA.href} class="btn btn-signal mt-7">{CTA.label}</a>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
      <div>
        <h2 class="text-sm font-semibold text-signal">Explore</h2>
        <ul class="mt-4 space-y-2.5">
          {NAV.map((n) => <li><a class="link text-mist/85 hover:text-paper" href={n.href}>{n.label}</a></li>)}
          <li><a class="link text-mist/85 hover:text-paper" href={CTA.href}>{CTA.label}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-signal">Follow</h2>
        <ul class="mt-4 space-y-2.5">
          <li><a class="link text-mist/85 hover:text-paper" href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a class="link text-mist/85 hover:text-paper" href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a class="link text-mist/85 hover:text-paper" href="/events.ics">Events calendar</a></li>
          <li><a class="link text-mist/85 hover:text-paper" href="/articles/rss.xml">Articles feed</a></li>
        </ul>
      </div>
      <div class="col-span-2 sm:col-span-1" id="contact">
        <h2 class="text-sm font-semibold text-signal">Contact</h2>
        <address class="mt-4 space-y-2.5 not-italic text-mist/85">
          <a class="link block hover:text-paper" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a class="link block hover:text-paper" href={`tel:${SITE.phone.replace(/[^+\d]/g, '')}`}>{SITE.phone}</a>
          <p class="pt-1 text-sm leading-relaxed">{SITE.address.map((l) => <>{l}<br /></>)}</p>
        </address>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="route-line text-mist" aria-hidden="true"></div>
    <div class="flex flex-col gap-2 py-5 text-sm text-mist/60 sm:flex-row sm:justify-between">
      <p>© {year} Laurier Supply Chain Association</p>
      <p>A Lazaridis Students' Society club at Wilfrid Laurier University</p>
    </div>
  </div>
</footer>
