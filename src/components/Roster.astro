---
import type { CollectionEntry } from 'astro:content';
import MemberCard from './MemberCard.astro';

interface Props { roster: CollectionEntry<'team'>; terms: { term: string; label: string; href: string }[] }
const { roster, terms } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const portfolios = roster.data.portfolios;
const pad = (n: number) => String(n).padStart(2, '0');
---
{/* One set of markup, two layouts: data-view switches between a carousel (one portfolio per slide) and the full list. */}
<div class="team" data-view="list">
  <script is:inline>
    // Apply the saved view before first paint so the page doesn't flash the wrong layout.
    (function () {
      var v = 'carousel';
      try { v = localStorage.getItem('lsca-team-view') || v; } catch (e) {}
      document.currentScript.parentElement.dataset.view = v === 'list' ? 'list' : 'carousel';
    })();
  </script>

  <div class="border-b border-mist-deep/70 bg-paper/95 backdrop-blur lg:sticky lg:top-[4.5rem] lg:z-30">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-3 gap-y-2 py-3">
      <nav aria-label="Portfolios" class="-mx-1 flex w-full gap-1.5 overflow-x-auto px-1 py-1 [scrollbar-width:none] lg:w-auto" data-chips>
        {portfolios.map((p, i) => <a href={`#${slug(p.name)}`} class="chip shrink-0 hover:border-harbour" data-goto={i}>{p.name}</a>)}
      </nav>
      <div class="flex flex-wrap items-center gap-2">
        <div class="js-only flex rounded-full border border-mist-deep p-0.5" role="group" aria-label="Layout" hidden>
          <button type="button" class="view-btn" data-set-view="carousel" aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="2.5" width="9" height="11" rx="1.5"/><path d="M1 4.5v7M15 4.5v7"/></svg>
            Carousel
          </button>
          <button type="button" class="view-btn" data-set-view="list" aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 3.5h12M2 8h12M2 12.5h12"/></svg>
            List
          </button>
        </div>
        {terms.length > 1 && (
          <nav aria-label="Year" class="flex gap-1.5">
            {terms.map((t) => (
              <a href={t.href} class="chip" aria-pressed={t.term === roster.data.term ? 'true' : 'false'} aria-current={t.term === roster.data.term ? 'page' : undefined}>{t.label}</a>
            ))}
          </nav>
        )}
      </div>
    </div>
  </div>

  <div class="wrap py-6 md:py-10">
    <div class="carousel-bar js-only items-center justify-between gap-4 pb-4" hidden>
      <p class="text-sm text-harbour/70">
        <span class="md:hidden">Swipe to see other portfolios</span>
        <span class="hidden md:inline">Use the arrows or portfolio tabs to browse</span>
      </p>
      <p class="sr-only" aria-live="polite" data-status></p>
      <div class="flex gap-2">
        <button type="button" class="arrow" data-step="-1" aria-label="Previous portfolio">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m10 3-5 5 5 5"/></svg>
        </button>
        <button type="button" class="arrow" data-step="1" aria-label="Next portfolio">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
        </button>
      </div>
    </div>

    <div class="track" data-track aria-roledescription="carousel" aria-label="Portfolios">
      {portfolios.map((p, i) => (
        <section id={slug(p.name)} class="slide" aria-labelledby={`${slug(p.name)}-h`} aria-roledescription="slide" data-slide>
          <div class="slide-head">
            <h2 id={`${slug(p.name)}-h`} class="heading text-2xl lg:text-[1.75rem]">{p.name}</h2>
            <p class="slide-count data text-sm text-harbour/55" aria-hidden="true">{pad(i + 1)} / {pad(portfolios.length)}</p>
          </div>
          <ul class="m-list grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
            {p.members.map((m) => <MemberCard member={m} />)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</div>

<style is:global>
  /* Layout toggle buttons. */
  .team .view-btn {
    display: inline-flex; align-items: center; gap: 0.375rem;
    border-radius: 999px; padding: 0.3rem 0.75rem;
    font-size: 0.8125rem; font-weight: 600; font-stretch: 90%;
    transition: background-color 150ms, color 150ms;
  }
  .team .view-btn[aria-pressed="true"] { background: var(--color-harbour); color: var(--color-paper); }
  .team .arrow {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem;
    border-radius: 999px; border: 1.5px solid var(--color-harbour);
    transition: background-color 150ms, color 150ms, opacity 150ms;
  }
  .team .arrow:hover:not(:disabled) { background: var(--color-harbour); color: var(--color-paper); }
  .team .arrow:disabled { opacity: 0.3; cursor: default; }
  .team .chip[aria-current="true"] { background: var(--color-harbour); border-color: var(--color-harbour); color: var(--color-paper); }

  /* ---- List view: every portfolio stacked, heading in a left column on desktop. ---- */
  .team[data-view="list"] .slide { display: grid; gap: 1.5rem; padding-block: 2.5rem; }
  .team[data-view="list"] .slide + .slide { border-top: 1px solid var(--color-mist-deep); }
  .team[data-view="list"] .slide-count { display: none; }
  @media (min-width: 1024px) {
    .team[data-view="list"] .slide { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem; }
    .team[data-view="list"] .slide-head { grid-column: span 3; }
    .team[data-view="list"] .slide-head h2 { position: sticky; top: 9rem; }
    .team[data-view="list"] .m-list { grid-column: span 9; }
  }

  /* ---- Carousel view: one portfolio per slide, swipe or arrow between them. ---- */
  .team[data-view="carousel"] .carousel-bar:not([hidden]) { display: flex; }
  .team[data-view="list"] .carousel-bar { display: none; }
  .team[data-view="carousel"] .track {
    position: relative; display: flex; align-items: flex-start; gap: 0.75rem;
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    scrollbar-width: none;
    /* Bleed to the screen edge on phones so the next slide peeks in. */
    margin-inline: -1rem; padding-inline: 1rem; scroll-padding-inline: 1rem;
    transition: height 250ms ease;
  }
  .team[data-view="carousel"] .track::-webkit-scrollbar { display: none; }
  .team[data-view="carousel"] .slide {
    flex: 0 0 calc(100% - 1.75rem);
    scroll-snap-align: start;
    border: 1px solid var(--color-mist-deep);
    border-radius: var(--radius-link);
    background: white;
    padding: 1.25rem;
  }
  .team[data-view="carousel"] .slide-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 1px solid var(--color-mist);
  }

  /* Phones and small tablets: each member becomes a compact row, listed vertically. */
  @media (max-width: 767px) {
    .team[data-view="carousel"] .m-list { grid-template-columns: 1fr; gap: 0.875rem; }
    .team[data-view="carousel"] .m-card { flex-direction: row; align-items: center; gap: 0.875rem; }
    .team[data-view="carousel"] .m-photo { width: 4.5rem; flex: none; border-radius: 0.875rem; padding: 0; }
    .team[data-view="carousel"] .m-photo-text { display: none; }
    .team[data-view="carousel"] .m-initials { font-size: 1.5rem; }
    .team[data-view="carousel"] .m-body { margin-top: 0; min-width: 0; flex: 1; }
    .team[data-view="carousel"] .m-name { font-size: 1rem; }
    .team[data-view="carousel"] .m-apply { display: inline; }
  }
  @media (min-width: 640px) {
    .team[data-view="carousel"] .track { margin-inline: -1.5rem; padding-inline: 1.5rem; scroll-padding-inline: 1.5rem; }
  }
  @media (min-width: 768px) {
    .team[data-view="carousel"] .track { margin-inline: 0; padding-inline: 0; scroll-padding-inline: 0; gap: 1.5rem; }
    .team[data-view="carousel"] .slide { flex-basis: 100%; padding: 2rem 2.25rem 2.25rem; }
    .team[data-view="carousel"] .slide-head { margin-bottom: 1.75rem; padding-bottom: 1.25rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.team').forEach((team) => {
    team.querySelectorAll<HTMLElement>('.js-only').forEach((el) => (el.hidden = false));

    const track = team.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...team.querySelectorAll<HTMLElement>('[data-slide]')];
    const chips = [...team.querySelectorAll<HTMLAnchorElement>('[data-goto]')];
    const chipRow = team.querySelector<HTMLElement>('[data-chips]')!;
    const prev = team.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
    const next = team.querySelector<HTMLButtonElement>('[data-step="1"]')!;
    const status = team.querySelector<HTMLElement>('[data-status]')!;
    const viewBtns = [...team.querySelectorAll<HTMLButtonElement>('[data-set-view]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const isCarousel = () => team.dataset.view === 'carousel';
    let active = 0;
    let ready = false;

    slides.forEach((s, i) => s.setAttribute('aria-label', `${i + 1} of ${slides.length}`));

    // The track takes the height of the visible slide, so short portfolios don't leave a gap.
    const fitHeight = () => {
      track.style.height = isCarousel() ? `${slides[active].offsetHeight}px` : '';
    };
    const sizeObserver = new ResizeObserver(fitHeight);

    const setActive = (i: number) => {
      if (i === active && track.style.height) return;
      sizeObserver.unobserve(slides[active]);
      active = i;
      sizeObserver.observe(slides[active]);
      fitHeight();
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      chips.forEach((c, j) => c.setAttribute('aria-current', String(isCarousel() && j === i)));
      const chip = chips[i];
      chipRow.scrollTo({ left: chip.offsetLeft - chipRow.clientWidth / 2 + chip.clientWidth / 2, behavior: 'smooth' });
      // Announce slide changes to screen readers, but not the initial setup.
      if (ready) status.textContent = `${slides[i].querySelector('h2')!.textContent}, ${i + 1} of ${slides.length}`;
    };

    // Slide offsets are relative to the track (it's position: relative), including its padding.
    const snapLeft = (i: number) => slides[i].offsetLeft - (parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0);
    const nearest = () => {
      if (track.scrollLeft >= track.scrollWidth - track.clientWidth - 2) return slides.length - 1;
      const dist = (i: number) => Math.abs(snapLeft(i) - track.scrollLeft);
      return slides.reduce((best, _, i) => (dist(i) < dist(best) ? i : best), 0);
    };

    const goTo = (i: number, smooth = true) => {
      i = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: snapLeft(i), behavior: smooth && !reduced.matches ? 'smooth' : 'auto' });
      setActive(i);
    };

    let ticking = false;
    track.addEventListener('scroll', () => {
      if (!isCarousel() || ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; setActive(nearest()); });
    }, { passive: true });

    prev.addEventListener('click', () => goTo(active - 1));
    next.addEventListener('click', () => goTo(active + 1));

    // In the carousel, portfolio chips act as tabs instead of jumping down the page.
    chips.forEach((c, i) => c.addEventListener('click', (e) => {
      if (!isCarousel()) return;
      e.preventDefault();
      goTo(i);
      history.replaceState(null, '', c.hash);
    }));

    track.addEventListener('keydown', (e) => {
      if (!isCarousel()) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(active + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(active - 1); }
    });

    const applyView = (v: string) => {
      team.dataset.view = v;
      viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setView === v)));
      if (v === 'carousel') {
        track.tabIndex = 0;
        track.scrollLeft = 0;
        goTo(active, false);
      } else {
        track.removeAttribute('tabindex');
        track.style.height = '';
        chips.forEach((c) => c.removeAttribute('aria-current'));
      }
    };
    viewBtns.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.setView!;
      try { localStorage.setItem('lsca-team-view', v); } catch {}
      applyView(v);
    }));

    // Open on the portfolio in the URL hash, e.g. /team#events.
    const fromHash = slides.findIndex((s) => `#${s.id}` === location.hash);
    if (fromHash > 0) active = fromHash;
    applyView(team.dataset.view === 'list' ? 'list' : 'carousel');
    ready = true;
  });
</script>
