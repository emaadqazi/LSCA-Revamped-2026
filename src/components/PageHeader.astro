---
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---
<section class="border-b border-mist-deep/70 bg-mist">
  <div class="wrap grid gap-6 pb-10 pt-12 md:grid-cols-12 md:pb-14 md:pt-20">
    <h1 class="display text-[clamp(2.4rem,7vw,4.75rem)] md:col-span-7">{title}</h1>
    {intro && <p class="max-w-xl self-end text-lg text-harbour/80 md:col-span-5">{intro}</p>}
    <slot />
  </div>
</section>
