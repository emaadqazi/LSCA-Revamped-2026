---
import { Image } from 'astro:assets';
import { teamPhoto, initials } from '../lib/images';

interface Props {
  member: { name: string; role: string; program?: string; photo?: string; linkedin?: string; status: 'active' | 'hiring'; applyUrl?: string };
}
const { member: m } = Astro.props;
const img = teamPhoto(m.photo);
---
{m.status === 'hiring' ? (
  <li class="flex flex-col">
    <div class="relative grid aspect-[4/5] place-items-center overflow-hidden rounded-[var(--radius-link)] border-2 border-dashed border-mist-deep bg-paper p-4 text-center">
      <div>
        <p class="heading text-lg">Position open</p>
        <p class="mt-1 text-sm text-harbour/70">We're hiring for this role.</p>
        {m.applyUrl && <a href={m.applyUrl} class="btn btn-ghost mt-4 !px-4 !py-1.5 text-sm" target="_blank" rel="noopener">Apply now</a>}
      </div>
    </div>
    <p class="heading mt-3 text-[1.05rem]">{m.role}</p>
    <p class="text-sm text-harbour/70">Applications open</p>
  </li>
) : (
  <li class="group flex flex-col">
    <div class="relative aspect-[4/5] overflow-hidden rounded-[var(--radius-link)] bg-mist">
      {img ? (
        <Image
          src={img}
          alt={`Headshot of ${m.name}`}
          widths={[240, 360, 480]}
          sizes="(min-width: 1024px) 220px, (min-width: 640px) 30vw, 45vw"
          class="headshot h-full w-full object-cover object-top"
          loading="lazy"
        />
      ) : (
        <div class="grid h-full w-full place-items-center" aria-hidden="true">
          <span class="display text-5xl text-harbour/35">{initials(m.name)}</span>
        </div>
      )}
    </div>
    <p class="heading mt-3 text-[1.05rem] leading-snug">{m.name}</p>
    <p class="text-[0.95rem] text-signal-ink">{m.role}</p>
    <div class="mt-0.5 flex items-center justify-between gap-2 text-sm text-harbour/65">
      {m.program && <span>{m.program}</span>}
      {m.linkedin && (
        <a href={m.linkedin} target="_blank" rel="noopener" class="-m-2 shrink-0 p-2 text-harbour/60 hover:text-harbour" aria-label={`${m.name} on LinkedIn`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
      )}
    </div>
  </li>
)}

<style>
  /* Mixed source photos sit together better with a light, shared grade until media-day headshots arrive. */
  .headshot { filter: saturate(0.85) contrast(1.02); transition: filter 200ms; }
  .group:hover .headshot { filter: none; }
</style>
