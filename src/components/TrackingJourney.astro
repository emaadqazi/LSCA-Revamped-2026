---
// The home page's set piece: a student's path through the club told as a shipment being tracked.
// Scrolling moves a parcel down the route; each stop lights up as it passes and the tracking card
// on the left updates its status. Driven by scripts/motion.ts ([data-track]).
import LinkMark from './LinkMark.astro';
import { CTA } from '../lib/site';

const stops = [
  {
    status: 'Order received',
    title: 'Come to one event',
    body: 'Panels, socials, workshops and competitions are open to every student. There is no membership fee and no sign-up: turning up is joining.',
    link: { href: '/events', label: 'See what\u2019s coming up' },
  },
  {
    status: 'Processing',
    title: 'Learn the vocabulary',
    body: 'Workshops and resources from our Education team that go past the BU275 and BU375 classroom, so the industry makes sense before you meet it.',
  },
  {
    status: 'In transit',
    title: 'Meet the people doing the work',
    body: 'Speaker panels bring professionals from consulting, retail, tech and academia to Lazaridis Hall. More than 150 students came to the last one.',
    link: { href: '/events/2025-10-careers-speaker-panel', label: 'See the last panel' },
  },
  {
    status: 'Out for delivery',
    title: 'Solve a real problem',
    body: 'Case competitions with the Supply Chain Department, like the US Tariffs Case Competition, put you under a real brief and a real deadline.',
  },
  {
    status: 'Delivered',
    title: 'Leave with a network',
    body: 'Trivia nights, networking nights and an executive team that knows the room. Then come back and run it: we hire new directors every fall.',
    link: { href: CTA.href, label: CTA.label },
  },
];
---
<section class="py-16 md:py-24" aria-labelledby="route-h" data-track>
  <div class="wrap">
    <div class="max-w-2xl">
      <h2 id="route-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)]" data-reveal>How a student moves through LSCA</h2>
      <p class="mt-4 text-lg text-harbour/80" data-reveal style="--i:1">
        Most of our members found supply chain at one of our events and kept coming back. Here is the route, stop by stop.
      </p>
    </div>

    <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="label" data-reveal="rise">
          <div class="flex items-center justify-between gap-4 border-b border-dashed border-mist-deep pb-4">
            <span class="flex items-center gap-2.5">
              <LinkMark class="h-8 w-8" />
              <span class="heading text-lg">LSCA tracking</span>
            </span>
            <span class="data text-sm text-harbour/60">No. 2012-WLU</span>
          </div>
          <dl class="mt-5 space-y-3 text-[0.95rem]">
            <div class="leader"><dt class="text-harbour/65">Shipment</dt><dd class="font-semibold">One Laurier student</dd></div>
            <div class="leader"><dt class="text-harbour/65">From</dt><dd class="font-semibold">Any program, any year</dd></div>
            <div class="leader"><dt class="text-harbour/65">To</dt><dd class="font-semibold">A career in supply chain</dd></div>
            <div class="leader">
              <dt class="text-harbour/65">Status</dt>
              <dd class="flex items-center gap-2 font-semibold">
                <span class="status-dot" aria-hidden="true"></span>
                <span data-track-status aria-live="off">Order received</span>
              </dd>
            </div>
          </dl>
          <div class="mt-6">
            <div class="flex justify-between text-sm text-harbour/65">
              <span>Progress</span>
              <span class="data text-harbour" data-track-pct>0%</span>
            </div>
            <div class="progress mt-2" aria-hidden="true"><span></span></div>
          </div>
          <div class="barcode mt-6 h-9 w-2/3 text-harbour/70" aria-hidden="true"></div>
        </div>
      </div>

      <ol class="route relative lg:col-span-7" data-track-path>
        <span class="rail" aria-hidden="true"></span>
        <span class="rail-fill" aria-hidden="true"></span>
        <span class="parcel" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
            <path d="M12 3 4 7v10l8 4 8-4V7l-8-4Z" /><path d="m4 7 8 4 8-4M12 11v10M8 5l8 4" />
          </svg>
        </span>
        {stops.map((s, i) => (
          <li class="stop" data-stop data-status={s.status}>
            <span class="node" data-node aria-hidden="true">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7" /></svg>
            </span>
            <p class="data text-[0.95rem] text-signal-ink">{s.status}</p>
            <h3 class="heading mt-1 text-2xl md:text-[1.75rem]">{s.title}</h3>
            <p class="mt-3 max-w-md text-harbour/80">{s.body}</p>
            {s.link && <a href={s.link.href} class="link mt-3 inline-block font-semibold">{s.link.label}</a>}
            {i === stops.length - 1 && <span class="sr-only">End of route.</span>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* The tracking card, cut like a shipping label with punched holes at the perforation. */
  .label {
    position: relative;
    padding: 1.5rem;
    border: 1px solid var(--color-mist-deep);
    border-radius: var(--radius-link);
    background: var(--color-paper);
    box-shadow: 0 1px 0 var(--color-mist-deep), 0 24px 48px -32px color-mix(in srgb, var(--color-harbour) 35%, transparent);
  }
  .label::before, .label::after {
    content: "";
    position: absolute;
    top: 4.35rem;
    width: 14px; height: 14px;
    border-radius: 999px;
    border: 1px solid var(--color-mist-deep);
    background: var(--color-paper);
  }
  .label::before { left: -8px; }
  .label::after { right: -8px; }

  .status-dot {
    width: 9px; height: 9px; border-radius: 999px;
    background: var(--color-signal);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-signal) 50%, transparent);
    animation: status 1.6s ease-out infinite;
  }
  @keyframes status { to { box-shadow: 0 0 0 7px transparent; } }

  .progress {
    height: 6px;
    border-radius: 999px;
    background: var(--color-mist);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--color-signal);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  /* Route geometry. scripts/motion.ts sets --rail-top and --rail-h to run from the first node to the last. */
  .route {
    --node: 2rem;
    --rail-top: 1rem;
    --rail-h: calc(100% - 2rem);
  }
  .rail, .rail-fill {
    position: absolute;
    left: calc(var(--node) / 2 - 1px);
    top: var(--rail-top);
    height: var(--rail-h);
    width: 2px;
  }
  .rail { background: repeating-linear-gradient(180deg, var(--color-mist-deep) 0 6px, transparent 6px 12px); }
  .rail-fill { background: var(--color-signal); transform-origin: top; transform: scaleY(var(--p)); }
  .parcel {
    position: absolute;
    left: calc(var(--node) / 2);
    top: calc(var(--rail-top) + var(--p) * var(--rail-h));
    display: grid;
    place-items: center;
    width: 2.5rem; height: 2.5rem;
    border-radius: 999px;
    color: var(--color-paper);
    background: var(--color-harbour);
    box-shadow: 0 0 0 5px var(--color-paper), 0 10px 24px -8px color-mix(in srgb, var(--color-harbour) 60%, transparent);
    translate: -50% -50%;
    z-index: 2;
  }

  .stop {
    position: relative;
    padding-left: calc(var(--node) + 1.5rem);
    padding-bottom: 3.5rem;
    transition: opacity 500ms;
    opacity: 0.45;
  }
  .stop:last-child { padding-bottom: 0; }
  .stop.is-reached { opacity: 1; }
  .node {
    position: absolute;
    left: 0; top: 0;
    display: grid;
    place-items: center;
    width: var(--node); height: var(--node);
    border-radius: 999px;
    border: 2px solid var(--color-mist-deep);
    background: var(--color-paper);
    color: var(--color-paper);
    transition: background-color 300ms, border-color 300ms, transform 500ms var(--ease-route);
  }
  .node svg { opacity: 0; transition: opacity 200ms 150ms; }
  .is-reached .node { background: var(--color-signal); border-color: var(--color-signal); }
  .is-reached .node svg { opacity: 1; }
  .is-current .node { transform: scale(1.15); box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-signal) 18%, transparent); }

  @media (min-width: 1024px) {
    /* The card rides along while the route scrolls past. */
    .label { position: sticky; top: 7rem; }
    /* Room to scroll: each stop owns a good slice of the viewport so the parcel's progress reads. */
    .stop { min-height: 34vh; padding-bottom: 4rem; }
    .stop:last-child { min-height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stop { opacity: 1; }
    .status-dot { animation: none; }
  }
</style>
