---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../lib/site';

// What each portfolio does. Keep in sync with the portfolio names in src/content/team/.
const portfolios = [
  { name: 'Corporate Relations', body: 'Builds relationships with companies and alumni, and brings speakers and sponsors to campus.' },
  { name: 'Events', body: 'Plans and runs our panels, socials and competitions, from booking rooms to running the night.' },
  { name: 'Education', body: 'Creates workshops, case competitions and learning resources that go beyond the BU275 and BU375 classroom.' },
  { name: 'Marketing', body: 'Runs our Instagram and LinkedIn, designs event promotion and keeps the LSCA brand consistent.' },
  { name: 'Software', body: 'Builds and maintains this website and the tools the team uses behind the scenes.' },
  { name: 'Finance', body: 'Manages the club budget, sponsorship funds and reimbursements.' },
  { name: 'Admin', body: 'Keeps the team running: internal operations, recruitment, and a first-year representative who speaks for new students.' },
];
---
<Base title="About" description="About the Laurier Supply Chain Association, the official supply chain club at Wilfrid Laurier University.">
  <PageHeader title="About LSCA" intro={`Founded in 2012, the Laurier Supply Chain Association is the official supply chain club at Wilfrid Laurier University and part of the Lazaridis Students' Society.`} />

  <section class="wrap grid gap-10 py-14 md:py-20 lg:grid-cols-12">
    <h2 class="heading text-[clamp(1.6rem,3vw,2.2rem)] lg:col-span-4">What we do</h2>
    <div class="max-w-2xl space-y-5 text-lg text-harbour/90 lg:col-span-8">
      <p>Supply chain is how a product gets from raw material to someone's hands: planning, sourcing, manufacturing, warehousing and transportation. Every industry depends on it, and most students don't see it until something breaks.</p>
      <p>We exist to show Laurier students what a career in supply chain looks like, and to put them in the room with people already doing the work. That means speaker panels with industry professionals, case competitions alongside the Supply Chain Department, hands-on workshops and socials that make the community feel small.</p>
      <p>Since 2012 we've reached more than 3,000 students. You don't need to be a supply chain major to join; most of our members found the field through one of our events.</p>
    </div>
  </section>

  <section class="border-y border-mist-deep/70 bg-mist py-14 md:py-20">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="heading text-[clamp(1.6rem,3vw,2.2rem)]">How the team is organized</h2>
        <p class="mt-4 text-harbour/80">Each portfolio is led by a VP and supported by directors. We hire new directors every fall.</p>
        <a href="/team" class="btn btn-ghost mt-6">Meet the team</a>
      </div>
      <dl class="grid gap-px overflow-hidden rounded-[var(--radius-link)] border border-mist-deep bg-mist-deep sm:grid-cols-2 lg:col-span-8">
        {portfolios.map((p) => (
          <div class="bg-paper p-5 sm:p-6">
            <dt class="heading text-lg">{p.name}</dt>
            <dd class="mt-1.5 text-harbour/80">{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="wrap grid gap-10 py-14 md:py-20 lg:grid-cols-12">
    <h2 class="heading text-[clamp(1.6rem,3vw,2.2rem)] lg:col-span-4">Faculty advisor</h2>
    <div class="max-w-2xl text-lg text-harbour/90 lg:col-span-8">
      <p>Dr. Michael Haughton, Program Director of Supply Chain Management at Laurier, advises the club and partners with us on academic events like the US Tariffs Case Competition.</p>
      <p class="mt-8 text-base text-harbour/80">Questions, partnerships or speaking opportunities: <a class="link font-semibold" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </section>
</Base>
