---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { longDate } from '../../lib/dates';
import { readingMinutes, getArticles } from '../../lib/content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (a) => import.meta.env.DEV || !a.data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const a = article.data;
const more = (await getArticles()).filter((x) => x.id !== article.id).slice(0, 2);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  datePublished: a.date.toISOString(),
  author: { '@type': 'Person', name: a.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  description: a.excerpt,
};
---
<Base title={a.title} description={a.excerpt} jsonLd={jsonLd} noindex={a.draft}>
  <article>
    <header class="border-b border-mist-deep/70 bg-mist">
      <div class="wrap pb-10 pt-8 md:pb-14 md:pt-12">
        <a href="/articles" class="link text-sm font-semibold">All articles</a>
        <div class="mx-auto mt-8 max-w-3xl">
          {a.tags.length > 0 && <p class="flex flex-wrap gap-2 text-sm font-semibold text-signal-ink">{a.tags.map((t) => <span>{t}</span>)}{a.draft && <span class="chip !border-dashed">Draft</span>}</p>}
          <h1 class="display mt-3 text-[clamp(2rem,5.5vw,3.6rem)]">{a.title}</h1>
          <p class="mt-5 text-xl text-harbour/80">{a.excerpt}</p>
          <p class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-sm text-harbour/75">
            <span><span class="font-semibold text-harbour">{a.author}</span>{a.authorRole && `, ${a.authorRole}`}</span>
            <time datetime={a.date.toISOString()}>{longDate(a.date)}</time>
            <span>{readingMinutes(article.body)} min read</span>
          </p>
        </div>
      </div>
    </header>
    <div class="wrap py-12 md:py-16">
      <div class="prose prose-lg mx-auto max-w-3xl prose-headings:font-bold prose-headings:[font-stretch:110%] prose-a:text-signal-ink prose-blockquote:border-signal prose-blockquote:font-medium prose-blockquote:not-italic prose-code:before:content-none prose-code:after:content-none prose-code:rounded prose-code:bg-mist prose-code:px-1.5 prose-code:py-0.5 prose-code:font-medium [--tw-prose-body:var(--color-harbour)] [--tw-prose-headings:var(--color-deep)] [--tw-prose-bold:var(--color-deep)] [--tw-prose-bullets:var(--color-signal)] [--tw-prose-quotes:var(--color-harbour)] [--tw-prose-code:var(--color-harbour)] [--tw-prose-th-borders:var(--color-mist-deep)] [--tw-prose-td-borders:var(--color-mist-deep)]">
        <Content />
      </div>
    </div>
  </article>
  {more.length > 0 && (
    <section class="border-t border-mist-deep/70 bg-mist py-12 md:py-16">
      <div class="wrap">
        <h2 class="heading text-2xl">More from LSCA</h2>
        <div class="mt-8 grid gap-10 sm:grid-cols-2">{more.map((m) => <ArticleCard article={m} />)}</div>
      </div>
    </section>
  )}
</Base>
