---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NetworkHero from '../components/NetworkHero.astro';
import IntroLoader from '../components/IntroLoader.astro';
import Waybill from '../components/Waybill.astro';
import TrackingJourney from '../components/TrackingJourney.astro';
import SpeakerBelt from '../components/SpeakerBelt.astro';
import EventRow from '../components/EventRow.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsItem from '../components/NewsItem.astro';
import { getEvents, getArticles, getNews, getWeeklyNews, getRosters } from '../lib/content';
import { teamPhoto } from '../lib/images';
import { shortDate } from '../lib/dates';
import { SITE } from '../lib/site';

const { upcoming } = await getEvents();
const articles = (await getArticles()).slice(0, 2);
// This week's five automated picks; before the first run, fall back to hand-picked links.
const { thisWeek, updated } = await getWeeklyNews();
const news = thisWeek.length ? thisWeek : (await getNews()).slice(0, 4);
const [roster] = await getRosters();
const members = roster.data.portfolios.flatMap((p) => p.members).filter((m) => m.status === 'active');
const faces = members.map((m) => ({ ...m, img: teamPhoto(m.photo) })).filter((m) => m.img).slice(0, 8);

const facts = [
  { label: 'Founded', value: '2012' },
  { label: 'Students reached', value: '3,000+', count: true },
  { label: 'Executives', value: String(members.length), count: true },
  { label: 'Portfolios', value: String(roster.data.portfolios.length), count: true },
];
---
<Base>
  <script slot="head" is:inline>
    // Decide before first paint whether to show the logo intro: once per visit, never with reduced motion.
    // `?intro` forces it, handy when demoing.
    try {
      var force = /[?&]intro\b/.test(location.search);
      if (force || (!sessionStorage.getItem('lsca-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches)) {
        document.documentElement.classList.add('intro');
        // Safety net: never leave the page covered if the intro script fails to run.
        setTimeout(function () {
          var h = document.documentElement;
          if (h.classList.contains('intro')) { h.classList.remove('intro'); dispatchEvent(new Event('lsca:intro-done')); }
        }, 7000);
      }
    } catch (e) {}
  </script>
  <IntroLoader />
  <NetworkHero />
  <Waybill rows={facts} />

  <!-- Upcoming events -->
  <section class="py-14 md:py-20" aria-labelledby="upcoming-h">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="upcoming-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)]" data-reveal>Coming up</h2>
        <a href="/events" class="link font-semibold">Full calendar</a>
      </div>
      {upcoming.length ? (
        <div class="mt-8 grid gap-4">
          {upcoming.slice(0, 3).map((e, i) => <EventRow event={e} index={i + 1} />)}
        </div>
      ) : (
        <p class="mt-6 max-w-xl rounded-[var(--radius-link)] border border-dashed border-mist-deep p-6 text-harbour/80" data-reveal="rise">
          Nothing is scheduled yet. New events are announced on <a class="link font-semibold" href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a>.
        </p>
      )}
    </div>
  </section>

  <TrackingJourney />
  <SpeakerBelt />

  <!-- Articles + industry news -->
  <section class="py-14 md:py-20">
    <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7" aria-labelledby="articles-h">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="articles-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)]" data-reveal>Written by our members</h2>
          <a href="/articles" class="link font-semibold">All articles</a>
        </div>
        {articles.length ? (
          <div class="mt-8 grid gap-10 sm:grid-cols-2">
            {articles.map((a, i) => <div data-reveal="rise" style={`--i:${i + 1}`}><ArticleCard article={a} /></div>)}
          </div>
        ) : (
          <p class="mt-6 text-harbour/80">Our first articles are on the way.</p>
        )}
      </div>
      <div class="lg:col-span-5" aria-labelledby="news-h">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="news-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)]" data-reveal>Industry news</h2>
          <a href="/news" class="link font-semibold">More reading</a>
        </div>
        {news.length ? (
          <div data-reveal="rise" style="--i:1">
            <ul class="mt-5 divide-y divide-mist-deep">
              {news.map((n) => <NewsItem item={n} compact />)}
            </ul>
            {thisWeek.length > 0 && updated && (
              <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-mist-deep bg-mist px-3 py-1.5 text-sm text-harbour/75">
                <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.25" /><path d="M8 4.5V8l2.5 1.5" /></svg>
                Updated <time datetime={updated.toISOString()}>{shortDate(updated)}</time>, five new stories every Monday
              </p>
            )}
          </div>
        ) : (
          <p class="mt-6 text-harbour/80">Links to supply chain stories we're following will appear here.</p>
        )}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="team relative overflow-hidden bg-deep py-14 text-mist md:py-20" aria-labelledby="team-h">
    <div class="wrap grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="team-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)] text-paper" data-reveal>Run by students, for students</h2>
        <p class="mt-4 max-w-md text-lg text-mist/80" data-reveal style="--i:1">
          {members.length} executives across {roster.data.portfolios.length} portfolios plan every event, write our articles and keep our partners close. Since 2012, LSCA has reached more than 3,000 students in the Lazaridis School and beyond.
        </p>
        <a href="/team" class="btn btn-signal mt-7" data-reveal="rise" style="--i:2">Meet the team</a>
      </div>
      <ul class="grid grid-cols-4 gap-2 sm:gap-3 lg:col-span-7" aria-label="Some of our executives">
        {faces.map((m, i) => (
          <li class="aspect-[4/5] overflow-hidden rounded-xl bg-harbour" data-reveal="rise" style={`--i:${(i % 4) + Math.floor(i / 4) * 2}`}>
            <Image src={m.img!} alt={m.name} widths={[160, 240]} sizes="(min-width:1024px) 150px, 22vw" class="h-full w-full object-cover object-top" loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
