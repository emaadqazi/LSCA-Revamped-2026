---
import Base from '../layouts/Base.astro';
import LinkMark from '../components/LinkMark.astro';
---
<Base title="Page not found" noindex>
  <section class="wrap grid min-h-[60vh] items-center gap-10 py-16 md:grid-cols-12">
    <div class="md:col-span-7">
      <h1 class="display text-[clamp(2.4rem,7vw,4.5rem)]">This page didn't arrive.</h1>
      <p class="mt-5 max-w-md text-lg text-harbour/80">The link may be out of date, or the page has moved. Try one of these instead.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Go to the home page</a>
        <a href="/events" class="btn btn-ghost">See events</a>
      </div>
    </div>
    <div class="hidden md:col-span-4 md:col-start-9 md:block" style="--lm-light: #cfdce6; --lm-dark: #0b4558;">
      <LinkMark class="w-full rotate-12" />
    </div>
  </section>
</Base>
