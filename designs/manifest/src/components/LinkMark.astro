---
// The LSCA chain-link mark, redrawn as SVG from the logo.
// `animate` plays the one-time interlock used in the home hero.
interface Props { class?: string; animate?: boolean; title?: string }
const { class: cls = '', animate = false, title } = Astro.props;
const clipId = `lm-${Math.random().toString(36).slice(2, 8)}`;
---
<svg
  viewBox="0 0 400 400"
  class:list={['link-mark', cls, { 'is-animated': animate }]}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <g fill="none" stroke-width="28">
    <g class="lm-top">
      <rect x="-52" y="-112" width="104" height="224" rx="52" transform="translate(212 152) rotate(45)" stroke="var(--lm-light, #0a9cc0)" />
    </g>
    <g class="lm-bottom">
      <rect x="-52" y="-112" width="104" height="224" rx="52" transform="translate(188 248) rotate(45)" stroke="var(--lm-dark, #0b4558)" />
    </g>
    <!-- Redraw a segment of the light link on top so the two links read as interlocked. -->
    <g class="lm-top">
      <clipPath id={clipId}><rect x="250" y="135" width="65" height="65" /></clipPath>
      <rect x="-52" y="-112" width="104" height="224" rx="52" transform="translate(212 152) rotate(45)" stroke="var(--lm-light, #0a9cc0)" clip-path={`url(#${clipId})`} />
    </g>
  </g>
</svg>

<style>
  .link-mark { display: block; overflow: visible; }
  .is-animated .lm-top { animation: lm-in-top 900ms cubic-bezier(.2,.8,.2,1) 150ms both; }
  .is-animated .lm-bottom { animation: lm-in-bottom 900ms cubic-bezier(.2,.8,.2,1) 150ms both; }
  @keyframes lm-in-top { from { transform: translate(70px, -70px); opacity: 0; } }
  @keyframes lm-in-bottom { from { transform: translate(-70px, 70px); opacity: 0; } }
</style>
