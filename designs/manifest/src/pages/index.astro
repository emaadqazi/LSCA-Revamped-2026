---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LinkMark from '../components/LinkMark.astro';
import EventRow from '../components/EventRow.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsItem from '../components/NewsItem.astro';
import { getEvents, getArticles, getNews, getRosters } from '../lib/content';
import { teamPhoto } from '../lib/images';
import { SITE } from '../lib/site';

const { upcoming } = await getEvents();
const articles = (await getArticles()).slice(0, 2);
const news = (await getNews()).slice(0, 4);
const [roster] = await getRosters();
const members = roster.data.portfolios.flatMap((p) => p.members).filter((m) => m.status === 'active');
const faces = members.map((m) => ({ ...m, img: teamPhoto(m.photo) })).filter((m) => m.img).slice(0, 8);
---
<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-mist">
    <div class="wrap relative grid gap-10 pb-12 pt-10 md:grid-cols-12 md:pb-20 md:pt-20">
      <div class="relative z-10 md:col-span-8 lg:col-span-7">
        <h1 class="display text-[clamp(2.6rem,8.2vw,5.6rem)] leading-[0.98]">
          Laurier's supply chain club, since 2012.
        </h1>
        <p class="mt-6 max-w-[34rem] text-lg text-harbour/85 md:text-xl">
          We connect students with the people who plan, source, make and move the world's goods, through speaker panels, case competitions and workshops.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/events" class="btn btn-primary">See upcoming events</a>
          <a href={SITE.social.slack} class="btn btn-ghost" target="_blank" rel="noopener">Join our Slack</a>
        </div>
      </div>
      <div class="pointer-events-none absolute -right-16 -top-6 w-[15rem] opacity-25 sm:w-[20rem] md:pointer-events-auto md:relative md:right-auto md:top-auto md:col-span-4 md:w-auto md:self-center md:opacity-100 lg:col-span-5 lg:-mr-10">
        <LinkMark animate title="Two interlocking chain links, the LSCA mark" class="w-full" />
      </div>
    </div>
  </section>

  <!-- Upcoming events -->
  <section class="py-14 md:py-20" aria-labelledby="upcoming-h">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="upcoming-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)]">Coming up</h2>
        <a href="/events" class="link font-semibold">Full calendar</a>
      </div>
      {upcoming.length ? (
        <div class="mt-8 grid gap-4">
          {upcoming.slice(0, 3).map((e) => <EventRow event={e} />)}
        </div>
      ) : (
        <p class="mt-6 max-w-xl rounded-[var(--radius-link)] border border-dashed border-mist-deep p-6 text-harbour/80">
          Nothing is scheduled yet. New events are announced on <a class="link font-semibold" href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a> and in our Slack.
        </p>
      )}
    </div>
  </section>

  <!-- Articles + industry news -->
  <section class="border-y border-mist-deep/70 bg-mist py-14 md:py-20">
    <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7" aria-labelledby="articles-h">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="articles-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)]">Written by our members</h2>
          <a href="/articles" class="link font-semibold">All articles</a>
        </div>
        {articles.length ? (
          <div class="mt-8 grid gap-10 sm:grid-cols-2">
            {articles.map((a) => <ArticleCard article={a} />)}
          </div>
        ) : (
          <p class="mt-6 text-harbour/80">Our first articles are on the way.</p>
        )}
      </div>
      <div class="lg:col-span-5" aria-labelledby="news-h">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="news-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)]">Industry news</h2>
          <a href="/news" class="link font-semibold">More reading</a>
        </div>
        {news.length ? (
          <ul class="mt-5 divide-y divide-mist-deep">
            {news.map((n) => <NewsItem item={n} compact />)}
          </ul>
        ) : (
          <p class="mt-6 text-harbour/80">Links to supply chain stories we're following will appear here.</p>
        )}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="bg-deep py-14 text-mist md:py-20" aria-labelledby="team-h">
    <div class="wrap grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="team-h" class="heading text-[clamp(1.75rem,3.5vw,2.5rem)] text-paper">Run by students, for students</h2>
        <p class="mt-4 max-w-md text-lg text-mist/80">
          {members.length} executives across {roster.data.portfolios.length} portfolios plan every event, write our articles and keep our partners close. Since 2012, LSCA has reached more than 3,000 students in the Lazaridis School and beyond.
        </p>
        <a href="/team" class="btn btn-signal mt-7">Meet the team</a>
      </div>
      <ul class="grid grid-cols-4 gap-2 sm:gap-3 lg:col-span-7" aria-label="Some of our executives">
        {faces.map((m) => (
          <li class="aspect-[4/5] overflow-hidden rounded-xl bg-harbour">
            <Image src={m.img!} alt={m.name} widths={[160, 240]} sizes="(min-width:1024px) 150px, 22vw" class="h-full w-full object-cover object-top" loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
