---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/content';

const articles = await getArticles();
const [lead, ...rest] = articles;
---
<Base title="Articles" description="Articles on supply chain, logistics and operations written by LSCA members.">
  <PageHeader title="Articles" intro="Writing from our members on supply chain, logistics, procurement and the careers around them." />
  <section class="wrap py-12 md:py-16">
    {lead ? (
      <>
        <div class="max-w-3xl"><ArticleCard article={lead} size="lg" /></div>
        {rest.length > 0 && <div class="mt-14 grid gap-12 sm:grid-cols-2 lg:grid-cols-3">{rest.map((a) => <ArticleCard article={a} />)}</div>}
      </>
    ) : (
      <p class="max-w-xl rounded-[var(--radius-link)] border border-dashed border-mist-deep p-6 text-harbour/80">
        Our first articles are being written now. Want to write one? Email <a class="link font-semibold" href="mailto:info@lsca.ca">info@lsca.ca</a>.
      </p>
    )}
  </section>
</Base>
