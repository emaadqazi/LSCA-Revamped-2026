---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import AddToCalendar from '../../components/AddToCalendar.astro';
import { longDate, timeRange, status } from '../../lib/dates';
import { speakerPhoto, initials } from '../../lib/images';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => import.meta.env.DEV || !e.data.draft);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const d = event.data;
const st = status(d.start, d.end);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: d.title,
  startDate: d.start.toISOString(),
  endDate: d.end?.toISOString(),
  description: d.summary,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: d.location, address: SITE.address.join(', ') },
  organizer: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---
<Base title={d.title} description={d.summary} jsonLd={jsonLd} noindex={d.draft}>
  <article>
    <header class="border-b border-mist-deep/70 bg-mist">
      <div class="wrap pb-10 pt-8 md:pb-14 md:pt-12">
        <a href="/events" class="link text-sm font-semibold">All events</a>
        <p class="mt-8 flex flex-wrap items-center gap-2 text-sm font-semibold text-signal-ink">
          {d.type}
          {st === 'past' && <span class="chip">Past event</span>}
          {st === 'this-week' && <span class="chip !border-signal !bg-signal/10">This week</span>}
          {d.draft && <span class="chip !border-dashed">Draft</span>}
        </p>
        <h1 class="display mt-3 max-w-4xl text-[clamp(2.2rem,6vw,4.25rem)]">{d.title}</h1>

        <dl class="mt-8 grid max-w-4xl gap-px overflow-hidden rounded-[var(--radius-link)] border border-mist-deep bg-mist-deep sm:grid-cols-3">
          <div class="bg-paper p-4"><dt class="text-sm text-harbour/65">Date</dt><dd class="data mt-1 text-lg">{longDate(d.start)}</dd></div>
          <div class="bg-paper p-4"><dt class="text-sm text-harbour/65">Time</dt><dd class="data mt-1 text-lg">{timeRange(d.start, d.end, d.allDay)}</dd></div>
          <div class="bg-paper p-4"><dt class="text-sm text-harbour/65">Location</dt><dd class="data mt-1 text-lg">{d.location}</dd></div>
        </dl>

        {st !== 'past' && (
          <div class="mt-6 flex flex-wrap gap-2">
            {d.registerUrl && <a href={d.registerUrl} class="btn btn-primary !py-2 text-sm" target="_blank" rel="noopener">Register</a>}
            <AddToCalendar event={event} />
          </div>
        )}
      </div>
    </header>

    <div class="wrap grid gap-12 py-12 md:py-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="text-xl text-harbour">{d.summary}</p>
        <div class="prose prose-lg mt-6 max-w-none prose-headings:font-bold prose-a:text-signal-ink [--tw-prose-body:var(--color-harbour)] [--tw-prose-bullets:var(--color-signal)]">
          <Content />
        </div>
        {d.audience && <p class="mt-8 rounded-[var(--radius-link)] bg-mist p-5 text-harbour/85"><span class="font-semibold">Who it's for:</span> {d.audience}</p>}
      </div>

      {d.speakers.length > 0 && (
        <aside class="lg:col-span-5" aria-labelledby="speakers-h">
          <h2 id="speakers-h" class="heading text-2xl">Speakers</h2>
          <ul class="mt-5 divide-y divide-mist-deep border-y border-mist-deep">
            {d.speakers.map((s) => {
              const img = speakerPhoto(s.photo);
              return (
                <li class="flex items-center gap-4 py-4">
                  <div class="h-16 w-16 shrink-0 overflow-hidden rounded-full bg-mist">
                    {img ? <Image src={img} alt="" width={128} height={128} class="h-full w-full object-cover" loading="lazy" /> : <span class="display grid h-full place-items-center text-lg text-harbour/40">{initials(s.name)}</span>}
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold">{s.name}</p>
                    <p class="text-sm text-harbour/75">{s.title}</p>
                  </div>
                  {s.linkedin && <a href={s.linkedin} target="_blank" rel="noopener" class="link shrink-0 text-sm">LinkedIn</a>}
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </article>
</Base>
