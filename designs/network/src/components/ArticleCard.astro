---
import type { CollectionEntry } from 'astro:content';
import { shortDate } from '../lib/dates';
import { readingMinutes } from '../lib/content';

interface Props { article: CollectionEntry<'articles'>; size?: 'lg' | 'md' }
const { article, size = 'md' } = Astro.props;
const a = article.data;
---
<article class="group relative flex flex-col border-t-2 border-harbour pt-5">
  <p class="flex flex-wrap gap-x-4 text-sm text-harbour/70">
    <time datetime={a.date.toISOString()}>{shortDate(a.date)}</time>
    <span>{readingMinutes(article.body)} min read</span>
    {a.draft && <span class="font-semibold text-signal-ink">Draft</span>}
  </p>
  <h3 class:list={['heading mt-2', size === 'lg' ? 'text-[clamp(1.6rem,3vw,2.2rem)]' : 'text-[1.35rem]']}>
    <a href={`/articles/${article.id}`} class="after:absolute after:inset-0 group-hover:underline decoration-1 underline-offset-4">{a.title}</a>
  </h3>
  <p class="mt-3 max-w-prose text-harbour/80">{a.excerpt}</p>
  <p class="mt-4 text-sm font-semibold">{a.author}{a.authorRole && <span class="font-normal text-harbour/65">, {a.authorRole}</span>}</p>
</article>
