---
import type { CollectionEntry } from 'astro:content';
import { day, monthShort, weekdayShort, timeRange, status } from '../lib/dates';

interface Props { event: CollectionEntry<'events'>; tone?: 'light' | 'muted' }
const { event, tone = 'light' } = Astro.props;
const d = event.data;
const st = status(d.start, d.end);
---
<article
  class:list={[
    'group relative grid grid-cols-[4.5rem_1fr] items-stretch overflow-hidden rounded-[var(--radius-link)] border bg-paper transition-colors sm:grid-cols-[6rem_1fr]',
    tone === 'muted' ? 'border-mist-deep/60' : 'border-mist-deep hover:border-harbour/50',
  ]}
  data-event-type={d.type}
>
  <!-- Date stub: the tear-off end of a shipping label. -->
  <div class:list={['flex flex-col items-center justify-center px-2 py-4 text-center', st === 'past' ? 'bg-mist text-harbour/70' : 'bg-harbour text-paper']}>
    <span class="data text-[0.8rem] opacity-80">{weekdayShort(d.start)}</span>
    <span class="data text-[2.1rem] leading-none sm:text-[2.6rem]">{day(d.start)}</span>
    <span class="data text-[0.85rem]">{monthShort(d.start)}</span>
  </div>

  <div class="relative border-l-2 border-dashed border-mist-deep p-4 sm:p-5">
    <span aria-hidden="true" class="absolute -left-[7px] -top-[7px] h-3 w-3 rounded-full border border-mist-deep bg-paper"></span>
    <span aria-hidden="true" class="absolute -bottom-[7px] -left-[7px] h-3 w-3 rounded-full border border-mist-deep bg-paper"></span>

    <div class="flex flex-wrap items-center gap-2 text-[0.8125rem] font-semibold">
      <span class="text-signal-ink">{d.type}</span>
      {st === 'this-week' && <span class="chip !border-signal !bg-signal/10 !text-signal-ink">This week</span>}
      {d.draft && <span class="chip !border-dashed">Draft, hidden on live site</span>}
    </div>
    <h3 class="heading mt-1.5 text-xl sm:text-[1.4rem]">
      <a href={`/events/${event.id}`} class="after:absolute after:inset-0 focus-visible:outline-none group-has-[a:focus-visible]:underline">{d.title}</a>
    </h3>
    <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[0.95rem] text-harbour/75">
      <span class="data !font-medium">{timeRange(d.start, d.end, d.allDay)}</span>
      <span>{d.location}</span>
    </p>
    {tone !== 'muted' && <p class="mt-3 max-w-2xl text-[0.95rem] text-harbour/85">{d.summary}</p>}
  </div>
</article>
