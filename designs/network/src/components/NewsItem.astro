---
import type { CollectionEntry } from 'astro:content';
import { shortDate } from '../lib/dates';

interface Props { item: CollectionEntry<'news'>; compact?: boolean }
const { item, compact = false } = Astro.props;
const n = item.data;
---
<li class="group relative py-4" data-news-tag={n.tag}>
  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-harbour/70">
    <span class="font-semibold text-signal-ink">{n.tag}</span>
    <span>{n.source}</span>
    <time datetime={n.date.toISOString()}>{shortDate(n.date)}</time>
    {n.draft && <span class="font-semibold">Draft</span>}
  </p>
  <h3 class:list={['mt-1 font-semibold leading-snug', compact ? 'text-[1.05rem]' : 'text-lg']}>
    <a href={n.url} target="_blank" rel="noopener" class="after:absolute after:inset-0 group-hover:underline decoration-1 underline-offset-4">
      {n.title}<span class="sr-only"> (opens {n.source} in a new tab)</span>
    </a>
    <svg class="ml-1 inline h-3.5 w-3.5 -translate-y-px text-harbour/50" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" /></svg>
  </h3>
  {!compact && n.takeaway && <p class="mt-2 max-w-prose text-[0.95rem] text-harbour/80"><span class="font-semibold">Why it matters:</span> {n.takeaway}</p>}
</li>
